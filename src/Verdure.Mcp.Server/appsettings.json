{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment": "Use environment variables in production: ConnectionStrings__DefaultConnection",
    "DefaultConnection": "Host=localhost;Database=verdure_mcp;Username=postgres;Password=postgres"
  },
  "AzureOpenAI": {
    "_comment": "Use environment variables in production: AzureOpenAI__Endpoint, AzureOpenAI__ApiKey",
    "Endpoint": "https://your-resource.openai.azure.com/",
    "ApiKey": "your-api-key-here",
    "DeploymentName": "dall-e-3",
    "ApiVersion": "2024-02-01"
  },
  "AzureOpenAIChat": {
    "_comment": "Dedicated Azure OpenAI configuration for AI group chat. Use environment variables in production: AzureOpenAIChat__Endpoint, AzureOpenAIChat__ApiKey",
    "Endpoint": "https://your-resource.openai.azure.com/",
    "ApiKey": "your-api-key-here",
    "DeploymentName": "gpt-4o-mini",
    "ApiVersion": "2024-02-01"
  },
  "Email": {
    "_comment": "Use environment variables in production for SmtpUsername and SmtpPassword",
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "SmtpUsername": "your-username",
    "SmtpPassword": "your-password",
    "UseSsl": true,
    "FromEmail": "noreply@example.com",
    "FromName": "Verdure MCP"
  },
  "Authentication": {
    "RequireToken": true,
    "DefaultTokenExpirationDays": 30,
    "DefaultDailyImageLimit": 10
  },
  "Keycloak": {
    "_comment": "Keycloak OIDC configuration",
    "Authority": "https://auth.verdure-hiro.cn",
    "Realm": "maker-community",
    "ClientId": "verdure-mcp-server",
    "ClientSecret": "",
    "Audience": "account",
    "RequireHttpsMetadata": true,
    "AdminRole": "admin"
  },
  "ImageStorage": {
    "_comment": "Image storage configuration. Use environment variable ImageStorage__BaseUrl in production",
    "StoragePath": "generated-images",
    "BaseUrl": "http://localhost:5000",
    "EnableAutoCleanup": true,
    "RetentionDays": 7
  },
  "McpServers": {
    "_comment": "MCP server configurations. Tools will be dynamically loaded from these servers.",
    "Servers": [
      {
        "Id": "dashscope-image",
        "Name": "DashScope Image Generation",
        "Endpoint": "https://api.dashscope.com/mcp",
        "AuthType": "BearerToken",
        "BearerToken": "your-dashscope-api-key-here",
        "TransportMode": "AutoDetect",
        "Enabled": false,
        "Description": "阿里云 DashScope 图像生成服务 (需要配置 BearerToken)"
      },
      {
        "Id": "example-oauth-server",
        "Name": "Example OAuth MCP Server",
        "Endpoint": "https://mcp.example.com",
        "AuthType": "OAuth",
        "OAuth": {
          "ClientId": "your-client-id",
          "ClientSecret": "your-client-secret",
          "RedirectUri": "http://localhost:5000/oauth/callback",
          "AuthorizationUrl": "https://auth.example.com/oauth/authorize",
          "TokenUrl": "https://auth.example.com/oauth/token"
        },
        "TransportMode": "Sse",
        "Enabled": false,
        "Description": "示例 OAuth 认证的 MCP 服务器"
      },
      {
        "Id": "local-test-server",
        "Name": "Local Test MCP Server",
        "Endpoint": "http://localhost:3000/mcp",
        "AuthType": "None",
        "TransportMode": "StreamableHttp",
        "Enabled": false,
        "Description": "本地测试 MCP 服务器（无需认证）"
      }
    ]
  }
}
